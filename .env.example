# ============================================================
# כלי המשכנתא — משתני סביבה
# ============================================================
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים שלך:
#   cp .env.example .env
#
# .env לעולם לא עולה ל-GitHub (.gitignore).
# .env.example עולה ל-GitHub כתבנית לכל סביבה חדשה.
# ============================================================

# ------ Google Gemini (חובה לדוחות AI) ------
# קבל מפתח חינמי: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------ Stripe (אופציונלי — רק אם מפעילים תשלום) ------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ------ מסד נתונים ------
# ב-Replit נטען אוטומטית. בפיתוח מקומי אפשר להשאיר ריק (in-memory fallback).
REPLIT_DB_URL=

# ------ שרת ------
PORT=3001
# כתובת הקליינט — ל-CORS ול-redirect של Stripe
CLIENT_URL=http://localhost:5173

# ------ תמחור (אגורות) ------
# ₪500 = 50000 אגורות. רלוונטי רק אם Stripe מופעל.
ANALYSIS_PRICE_AGOROT=50000
