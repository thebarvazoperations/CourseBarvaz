# Google Gemini API (חינמי) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Replit DB (נטען אוטומטית בתוך Replit). מחוץ ל-Replit אפשר להגדיר נתיב מקומי
DATABASE_URL=

# Server
PORT=3001
# כתובת הקליינט (ל-CORS ול-redirect של Stripe)
CLIENT_URL=http://localhost:5173

# מחיר הניתוח באגורות (₪500 = 50000 אגורות)
ANALYSIS_PRICE_AGOROT=50000
