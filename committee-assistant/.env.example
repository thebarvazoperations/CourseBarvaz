# העתק קובץ זה ל-.env ומלא את הערכים

# מפתח ה-API של Anthropic (חובה כדי שהרופא ה-AI יעבוד)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# מודל Claude לשימוש (ברירת מחדל: claude-sonnet-4-6)
# אפשרויות: claude-opus-4-8 (הכי חזק), claude-sonnet-4-6 (מאוזן), claude-haiku-4-5-20251001 (מהיר וזול)
CLAUDE_MODEL=claude-sonnet-4-6

# פורט להרצת השרת
PORT=3000
